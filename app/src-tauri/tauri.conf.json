{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna Player",
  "version": "1.4.8",
  "identifier": "com.modernplayer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luna Player",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "transparent": true,
        "backgroundColor": "#0A0A0B00",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --disable-background-timer-throttling"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/thumbs/**",
          "$APPCACHE/covers/**",
          "$APPCACHE/previews/**",
          "$APPLOCALDATA/fonts/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "mpv/mpv.exe": "mpv/mpv.exe",
      "mpv/mpv.com": "mpv/mpv.com",
      "mpv/yt-dlp/": "mpv/yt-dlp/",
      "fonts/": "fonts/",
      "mpv/d3dcompiler_43.dll": "mpv/d3dcompiler_43.dll",
      "mpv/mpv/fonts.conf": "mpv/mpv/fonts.conf",
      "mpv/Copyright": "mpv/Copyright",
      "mpv/LICENSE.GPL": "mpv/LICENSE.GPL",
      "mpv/LICENSE.LGPL": "mpv/LICENSE.LGPL",
      "mpv/yt-dlp-LICENSE.txt": "mpv/yt-dlp-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Luna Player",
    "shortDescription": "Luna Player",
    "longDescription": "An mpv-based video player with a library, recommendations and a film assistant",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "Luna Player",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGOTI3MkQyNDY3MzE2REQKUldUZEZuTkcwbktTSDdWTDAwaUFNVmZqamc1R3lpTHJ3bXJiR0p3anp0ZzlybjRUU2Z4UVZWclAK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}