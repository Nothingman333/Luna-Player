{
  "manifest_version": 3,
  "name": "Luna Player",
  "version": "0.5.0",
  "description": "Videoları, bağlantıları ve müzikleri tek tıkla Luna Player'a gönder.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "icons": { "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Luna'da oynat", "default_popup": "popup.html", "default_icon": { "32": "icons/32.png", "48": "icons/48.png" } },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*", "https://open.spotify.com/*"], "js": ["page-buttons.js"], "css": ["page-buttons.css"] }
  ]
}
